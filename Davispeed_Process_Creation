// ==UserScript==
// @name         Davispeed Process Creation
// @namespace    https://www.worten.pt/
// @version      0.6.7
// @description  Assistente de preenchimento da Worten Resolve
// @match        *://www.worten.pt/resolve/forms/*
// @match        *://*.worten.pt/resolve/forms/*
// @match        *://bookingcenter.worten.site/*
// @match        *://*.bookingcenter.worten.site/*
// @run-at       document-idle
// @grant        GM_getValue
// @grant        GM_setValue
// ==/UserScript==

(() => {
  'use strict';

  const STORE = 'davispeedProcessCreationState_v3';
  const MAX_PHYSICAL_RETRIES = 3;
  const MAX_NEXT_RETRIES = 3;

  const PROCESS_TYPES = {
    GUARANTEE: 'Garantia / Orçamento',
    SERVICE: 'Serviços Resolve'
  };

  const CONDITIONS = [
    'Sem danos com sinais de uso',
    'Com danos'
  ];

  const PROBLEMS = [
    'Não liga',
    'Não dá imagem',
    'Não tem som',
    'Não carrega',
    'Problema de bateria',
    'Problema de ecrã',
    'Ecrã partido',
    'Problema de ligação/rede',
    'Sobreaquece',
    'Ruído anormal',
    'Outro (especificar)'
  ];

  const PROBLEM_TEXT = {
    'Não liga': 'O equipamento não liga.',
    'Não dá imagem': 'O equipamento não apresenta imagem.',
    'Não tem som': 'O equipamento não apresenta som.',
    'Não carrega': 'O equipamento não carrega.',
    'Problema de bateria': 'O equipamento apresenta um problema de bateria.',
    'Problema de ecrã': 'O equipamento apresenta um problema no ecrã.',
    'Ecrã partido': 'O equipamento apresenta o ecrã partido/danificado.',
    'Problema de ligação/rede': 'O equipamento apresenta problemas de ligação/rede.',
    'Sobreaquece': 'O equipamento sobreaquece durante a utilização.',
    'Ruído anormal': 'O equipamento apresenta ruídos anormais durante a utilização.',
    'Outro (especificar)': 'Descreve a anomalia observada.'
  };

  const SERVICE_TYPES = {
    'Apple': {
      sku: '7205552',
      cardLabel: 'PREST SERVIÇO MOBILE APPLE'
    },
    'Samsung': {
      sku: '7205553',
      cardLabel: 'PREST SERVIÇO MOBILE SAMSUNG'
    },
    'Huawei': {
      sku: '7205557',
      cardLabel: 'PREST SERVIÇO MOBILE HUAWEI'
    },
    'Outras marcas': {
      sku: '7205559',
      cardLabel: 'PREST SERVIÇO MOBILE OUTRAS MARCAS'
    }
  };

  const DEFAULTS = {
    processType: PROCESS_TYPES.GUARANTEE,
    signature: '',
    serviceType: 'Apple',
    serial: '',
    condition: CONDITIONS[0],
    extraPhysicalDetails: '',
    accessories: 'Não',
    accessoryDetails: '',
    problem: PROBLEMS[0],
    otherProblem: '',
    autoContinue: false
  };

  let state = { ...DEFAULTS };
  let ui = null;

  let running = false;
  let stopRequested = false;
  let resumePending = false;

  let physicalRetryCount = 0;
  let nextRetryCount = 0;

  const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
  const norm = value => String(value ?? '').replace(/\s+/g, ' ').trim();
  const lower = value => norm(value).toLocaleLowerCase('pt-PT');
  const txt = element => norm(element?.innerText || element?.textContent || '');
  const bodyText = () => norm(document.body?.innerText || '');

  function isServiceProcess() {
    return state.processType === PROCESS_TYPES.SERVICE;
  }

  function visible(element) {
    if (!element || !element.isConnected) return false;

    const css = getComputedStyle(element);
    const rect = element.getBoundingClientRect();

    return css.display !== 'none'
      && css.visibility !== 'hidden'
      && Number(css.opacity) !== 0
      && rect.width > 0
      && rect.height > 0;
  }

  function visibleInputs() {
    return [...document.querySelectorAll('input,textarea,select')]
      .filter(visible);
  }

  function headings() {
    return [...document.querySelectorAll('h1,h2,h3,h4,[role="heading"]')]
      .filter(visible)
      .map(txt)
      .join(' | ');
  }

  async function loadState() {
    try {
      if (typeof GM_getValue === 'function') {
        const saved = await GM_getValue(STORE, '');

        if (saved) {
          return {
            ...DEFAULTS,
            ...(typeof saved === 'string' ? JSON.parse(saved) : saved)
          };
        }
      }
    } catch (error) {
      console.warn('[Davispeed] Erro ao carregar dados:', error);
    }

    try {
      const saved = localStorage.getItem(STORE);

      if (saved) return { ...DEFAULTS, ...JSON.parse(saved) };
    } catch (error) {
      console.warn('[Davispeed] Erro no armazenamento local:', error);
    }

    return { ...DEFAULTS };
  }

  async function saveState() {
    try {
      if (typeof GM_setValue === 'function') {
        await GM_setValue(STORE, JSON.stringify(state));
        return;
      }
    } catch (error) {
      console.warn('[Davispeed] Erro ao guardar dados:', error);
    }

    try {
      localStorage.setItem(STORE, JSON.stringify(state));
    } catch (error) {
      console.warn('[Davispeed] Não foi possível guardar os dados:', error);
    }
  }

  function readPanel() {
    if (!ui) return;

    state.processType = ui.processType.value;
    state.signature = ui.signature.value.trim();
    state.serviceType = ui.serviceType.value;
    state.serial = ui.serial.value.trim();
    state.condition = ui.condition.value;
    state.extraPhysicalDetails = ui.extraPhysicalDetails.value.trim();
    state.accessories = ui.accessories.value;
    state.accessoryDetails = ui.accessoryDetails.value.trim();
    state.problem = ui.problem.value;
    state.otherProblem = ui.otherProblem.value.trim();
  }

  async function savePanel() {
    readPanel();
    await saveState();
  }

  function status(message, kind = 'info') {
    if (!ui?.status) return;

    ui.status.textContent = message;
    ui.status.dataset.kind = kind;
  }

  function fieldContext(element) {
    const parts = [
      element.getAttribute('aria-label'),
      element.getAttribute('placeholder'),
      element.getAttribute('name'),
      element.id,
      element.getAttribute('type')
    ];

    if (element.id) {
      const label = document.querySelector(
        `label[for="${CSS.escape(element.id)}"]`
      );

      if (label) parts.push(txt(label));
    }

    let node = element.parentElement;

    for (let i = 0; node && i < 3; i++, node = node.parentElement) {
      const text = txt(node);

      if (text && text.length < 220) {
        parts.push(text);
      }
    }

    return lower(parts.filter(Boolean).join(' '));
  }

  function setNativeValue(element, value) {
    if (!element) return false;

    const proto = element instanceof HTMLTextAreaElement
      ? HTMLTextAreaElement.prototype
      : element instanceof HTMLSelectElement
        ? HTMLSelectElement.prototype
        : HTMLInputElement.prototype;

    const setter = Object.getOwnPropertyDescriptor(proto, 'value')?.set;

    try {
      element._valueTracker?.setValue(String(element.value ?? ''));
    } catch (_) {}

    if (setter) {
      setter.call(element, String(value ?? ''));
    } else {
      element.value = String(value ?? '');
    }

    try {
      element.dispatchEvent(new InputEvent('input', {
        bubbles: true,
        composed: true,
        inputType: 'insertText',
        data: String(value ?? '')
      }));
    } catch (_) {
      element.dispatchEvent(new Event('input', {
        bubbles: true,
        composed: true
      }));
    }

    element.dispatchEvent(new Event('change', {
      bubbles: true,
      composed: true
    }));

    return true;
  }

  function findSerialInput() {
    const fields = visibleInputs().filter(element =>
      element.matches('input:not([type="hidden"]):not([type="email"]),textarea')
    );

    const found = fields.find(element =>
      /n[uú]mero de s[eé]rie|imei|serial/.test(fieldContext(element))
    );

    if (found) return found;

    const serviceSerial = document.querySelector('input[name="4264"]');

    if (serviceSerial && visible(serviceSerial)) {
      return serviceSerial;
    }

    if (/insere o n[uú]mero de s[eé]rie|insira o n[uú]mero de s[eé]rie|imei/.test(lower(headings()))) {
      return fields.find(element =>
        element instanceof HTMLInputElement &&
        /^(text|search|tel)$/i.test(element.type)
      ) || null;
    }

    return null;
  }

  function exactOption(label) {
    const wanted = lower(label);

    return [...document.querySelectorAll(
      'span,button,label,[role="option"],[role="button"],[role="radio"],div'
    )]
      .filter(visible)
      .filter(element => lower(txt(element)) === wanted)
      .sort((a, b) =>
        Number(a.children.length !== 0) -
        Number(b.children.length !== 0)
      )[0] || null;
  }

  function clickChoice(label) {
    const wanted = lower(label);

    if (wanted === 'loja') {
      const span = [
        ...document.querySelectorAll('div.sc-fedTIj span.sc-dxUMQK')
      ]
        .filter(visible)
        .find(element => lower(txt(element)) === 'loja');

      if (span) {
        const card = span.closest('div.sc-fedTIj');

        if (card && visible(card)) {
          card.scrollIntoView({ block: 'center', behavior: 'auto' });
          card.click();

          console.log('[Davispeed] Selecionado Loja.', card);
          return true;
        }
      }
    }

    const element = exactOption(label);
    if (!element) return false;

    const target =
      element.closest('div.sc-fedTIj') ||
      element.closest('[role="radio"]') ||
      element.closest('button,label,[role="button"],[role="option"],[tabindex]') ||
      element.parentElement ||
      element;

    target.scrollIntoView({ block: 'center', behavior: 'auto' });
    target.click();

    console.log(`[Davispeed] Selecionada a opção "${label}".`, target);
    return true;
  }

  function findNextButton() {
    const candidates = [
      ...document.querySelectorAll('button'),
      ...document.querySelectorAll('[role="button"]')
    ];

    return candidates.find(element => {
      if (!visible(element)) return false;

      const label = norm(
        element.innerText ||
        element.textContent ||
        element.getAttribute('aria-label') ||
        ''
      );

      return /^seguinte$/i.test(label)
        && !element.disabled
        && element.getAttribute('aria-disabled') !== 'true';
    }) || null;
  }

  function clickNext() {
    const button = findNextButton();

    if (!button) {
      console.warn('[Davispeed] Botão Seguinte não encontrado ou inativo.');
      return false;
    }

    button.scrollIntoView({ block: 'center', behavior: 'auto' });
    button.click();

    nextRetryCount = 0;

    console.log('[Davispeed] Botão Seguinte clicado.', button);
    return true;
  }

  function isCustomerStep() {
    const headingText = lower(headings());

    if (/dados do cliente|dados pessoais|identifica[cç][aã]o do cliente|email e dados|e-?mail do cliente/.test(headingText)) {
      return true;
    }

    if (visibleInputs().some(element =>
      element instanceof HTMLInputElement && element.type === 'email'
    )) {
      return true;
    }

    return visibleInputs().some(element =>
      /e-?mail|nome do cliente|telefone do cliente|telem[oó]vel do cliente/.test(
        fieldContext(element)
      )
    ) && /cliente|email|e-mail|contacto|contato/.test(
      lower(bodyText().slice(0, 900))
    );
  }

  function detectStage() {
    if (isCustomerStep()) return 'customer';

    const combined = lower(
      headings() + ' ' + bodyText().slice(0, 1800)
    );

    if (/o produto encontra-se dentro de garantia/.test(combined)) {
      return 'serviceWarranty';
    }

    if (/indica o sku relativo ao servi[cç]o|tipo de servi[cç]o/.test(combined)) {
      if (isServiceProcess()) return 'serviceType';
    }

    if (/qual a data de compra do produto/.test(combined)) {
      return 'purchaseDate';
    }

    if (/qual o pre[cç]o\s*\(pvp\)\s*do equipamento/.test(combined)) {
      return 'pvp';
    }

    if (/tipifica a avaria do produto/.test(combined)) {
      return 'damageType';
    }

    if (
      /d[eê]-nos os detalhes.*problema|detalhes do\(s\) problema|detalhes do problema identificado/.test(combined)
    ) {
      if (isServiceProcess()) return 'anomaly';
    }

    if (/indique informa[cç][aã]o adicional relevante que possa ajudar na realiza[cç][aã]o do servi[cç]o/.test(combined)) {
      return 'additional';
    }

    if (/servi[cç]o de entrega e recolha\s*\(woc\)/i.test(combined)) {
      return 'woc';
    }

    if (/localiza[cç][aã]o f[ií]sica do artigo/.test(combined)) {
      return 'origin';
    }

    if (/\banexos\b|adicione imagens ao seu pedido/.test(combined)) {
      return 'attachments';
    }

    if (/descreve o estado f[ií]sico do equipamento/.test(combined)) {
      return 'physical';
    }

    if (/descreve o\(s\) acess[oó]rio\(s\)|o servi[cç]o inclui acess[oó]rios|acess[oó]rios/.test(combined)) {
      return 'accessories';
    }

    if (
      /d[eê]-nos os detalhes.*problema|detalhes do\(s\) problema|indique os problemas com o seu equipamento|problemas com o seu equipamento|detalha o problema do equipamento/.test(combined)
    ) {
      return 'anomaly';
    }

    if (
      /qual o estado do produto\??/.test(combined) ||
      (exactOption(CONDITIONS[0]) && exactOption(CONDITIONS[1]))
    ) {
      return 'condition';
    }

    if (
      /insere o n[uú]mero de s[eé]rie|insira o n[uú]mero de s[eé]rie|imei/.test(combined) &&
      findSerialInput()
    ) {
      return 'serial';
    }

    const physicalSelector = isServiceProcess()
      ? 'textarea[name="7982"]'
      : 'textarea[name="4228"]';

    const physical = document.querySelector(physicalSelector);
    if (physical && visible(physical)) return 'physical';

    const accessories = document.querySelector('textarea[name="4682"]');
    if (accessories && visible(accessories)) return 'accessories';

    const anomalySelector = isServiceProcess()
      ? 'textarea[name="8224"]'
      : 'textarea[name="4215"]';

    const anomaly = document.querySelector(anomalySelector);
    if (anomaly && visible(anomaly)) return 'anomaly';

    const additional = document.querySelector('textarea[name="4265"]');
    if (additional && visible(additional)) return 'additional';

    return 'unknown';
  }

  function missingRequiredFields() {
    const missing = [];

    if (!Object.values(PROCESS_TYPES).includes(ui.processType.value)) {
      missing.push('Tipo de processo');
    }

    if (!ui.signature.value.trim()) {
      missing.push('Assinatura');
    }

    if (
      isServiceProcess() &&
      !Object.prototype.hasOwnProperty.call(SERVICE_TYPES, ui.serviceType.value)
    ) {
      missing.push('Tipo de Serviço');
    }

    if (!ui.serial.value.trim()) missing.push('Nº Série / IMEI');
    if (!CONDITIONS.includes(ui.condition.value)) missing.push('estado do produto');
    if (!ui.extraPhysicalDetails.value.trim()) missing.push('Detalhes do estado físico');
    if (!['Sim', 'Não'].includes(ui.accessories.value)) missing.push('indicação de acessórios');

    if (
      !isServiceProcess() &&
      ui.accessories.value === 'Sim' &&
      !ui.accessoryDetails.value.trim()
    ) {
      missing.push('descrição dos acessórios');
    }

    if (!PROBLEMS.includes(ui.problem.value)) missing.push('Anomalia');
    if (!ui.otherProblem.value.trim()) missing.push('Detalhes da anomalia');

    return missing;
  }

  function syncStartButton() {
    if (!ui?.start) return;

    const missing = missingRequiredFields();

    ui.start.disabled = running || missing.length > 0;

    ui.start.title = missing.length
      ? `Preenche os campos obrigatórios: ${missing.join(', ')}`
      : 'Iniciar ou continuar';
  }

  function syncProcessUI() {
    if (!ui) return;

    const service = isServiceProcess();

    ui.serviceTypeWrap.style.display = service ? 'block' : 'none';
    ui.accessoryDetailsWrap.style.display = service ? 'none' : 'block';

    ui.accessoryDetails.disabled =
      service || ui.accessories.value !== 'Sim';

    ui.accessoryDetails.required =
      !service && ui.accessories.value === 'Sim';

    syncStartButton();
  }

  function problemTemplate(problem) {
    return PROBLEM_TEXT[problem] ||
      `O equipamento apresenta a seguinte anomalia: ${problem}.`;
  }

  async function setPageFieldAndConfirm(selector, value, attempts = 12) {
    const wanted = String(value ?? '').trim().slice(0, 300);
    if (!wanted) return null;

    for (let i = 0; i < attempts; i++) {
      if (stopRequested) return null;

      const element = typeof selector === 'function'
        ? selector()
        : document.querySelector(selector);

      if (
        element &&
        visible(element) &&
        !element.disabled &&
        !element.readOnly
      ) {
        element.scrollIntoView({ block: 'center', behavior: 'auto' });

        try {
          element.focus({ preventScroll: true });
        } catch (_) {
          element.focus();
        }

        setNativeValue(element, wanted);
        await sleep(300);

        const check = typeof selector === 'function'
          ? selector()
          : document.querySelector(selector);

        if (
          check &&
          visible(check) &&
          String(check.value ?? '').trim() === wanted
        ) {
          return check;
        }
      }

      await sleep(250);
    }

    return null;
  }

  async function fillNumberField(selector, value, attempts = 10) {
    const wanted = String(value);

    for (let i = 0; i < attempts; i++) {
      if (stopRequested) return null;

      const element = document.querySelector(selector);

      if (
        element &&
        visible(element) &&
        !element.disabled &&
        !element.readOnly
      ) {
        element.scrollIntoView({ block: 'center', behavior: 'auto' });
        setNativeValue(element, wanted);
        await sleep(250);

        if (String(element.value).trim() === wanted) return element;
      }

      await sleep(250);
    }

    return null;
  }

  async function fillPurchaseDate() {
    const fields = [
      ...document.querySelectorAll('input[type="number"]')
    ].filter(visible);

    const day = fields.find(element =>
      element.id === 'day' ||
      element.name === 'day' ||
      element.placeholder === 'DD'
    );

    if (!day) {
      console.warn('[Davispeed] Campo do dia não encontrado.');
      return false;
    }

    const months = fields.filter(element =>
      element !== day &&
      (
        element.id === 'month' ||
        element.name === 'month' ||
        element.placeholder === 'MM'
      )
    );

    const month = months[0];

    if (!month) {
      console.warn('[Davispeed] Campo do mês não encontrado.');
      return false;
    }

    let year = fields.find(element =>
      element !== day &&
      element !== month &&
      (
        element.id === 'year' ||
        element.name === 'year' ||
        /ano|year|aaaa|yyyy/i.test(
          `${element.placeholder || ''} ${fieldContext(element)}`
        )
      )
    );

    if (!year) {
      const remaining = fields.filter(element =>
        element !== day && element !== month
      );

      if (remaining.length === 1) year = remaining[0];
    }

    if (!year) {
      console.warn('[Davispeed] Campo do ano não encontrado.');
      return false;
    }

    setNativeValue(day, '2');
    await sleep(200);

    setNativeValue(month, '2');
    await sleep(200);

    setNativeValue(year, '2022');
    await sleep(300);

    const confirmed =
      String(day.value).trim() === '2' &&
      String(month.value).trim() === '2' &&
      String(year.value).trim() === '2022';

    console.log('[Davispeed] Confirmação da data 02/02/2022:', confirmed);
    return confirmed;
  }

  function findServiceCard(service) {
    const cards = [
      ...document.querySelectorAll('div.sc-kuCHnY')
    ].filter(visible);

    const exact = cards.find(card => {
      const text = lower(txt(card));

      return text.includes(service.sku) &&
        text.includes(lower(service.cardLabel));
    });

    if (exact) return exact;

    const fallback = [
      ...document.querySelectorAll('div[class*="sc-kuCHnY"]')
    ]
      .filter(visible)
      .filter(card => {
        const text = lower(txt(card));

        return text.includes(service.sku) &&
          text.includes(lower(service.cardLabel));
      })
      .sort((a, b) => norm(txt(a)).length - norm(txt(b)).length);

    return fallback[0] || null;
  }

  async function fillServiceSKU() {
    const service = SERVICE_TYPES[ui.serviceType.value];

    if (!service) return false;

    let input = document.querySelector('input[placeholder="Tipo de Serviço"]');

    if (!input || !visible(input)) {
      console.warn('[Davispeed] Não encontrei o campo Tipo de Serviço.');
      return false;
    }

    input.scrollIntoView({ block: 'center', behavior: 'auto' });
    input.focus();
    setNativeValue(input, service.sku);

    console.log(`[Davispeed] SKU ${service.sku} escrito.`);

    const deadline = Date.now() + 10000;
    let card = null;

    while (Date.now() < deadline) {
      if (stopRequested) return false;

      card = findServiceCard(service);

      if (card) break;

      await sleep(250);
    }

    if (!card) {
      console.warn(`[Davispeed] Cartão ${service.sku} não encontrado.`);
      return false;
    }

    card.scrollIntoView({ block: 'center', behavior: 'auto' });
    await sleep(200);

    console.log(`[Davispeed] A clicar diretamente no cartão ${service.sku}.`, card);
    card.click();

    await sleep(800);

    if (stopRequested) return false;

    if (await waitForChange('serviceType', 1800)) {
      console.log('[Davispeed] O cartão avançou automaticamente.');
      return true;
    }

    const nextDeadline = Date.now() + 6000;
    let nextButton = null;

    while (Date.now() < nextDeadline) {
      if (stopRequested) return false;
      if (detectStage() !== 'serviceType') return true;

      nextButton = findNextButton();
      if (nextButton) break;

      await sleep(250);
    }

    if (!nextButton) {
      await stop(
        'O cartão do serviço foi clicado, mas o botão Seguinte não ficou ativo.',
        'warn'
      );
      return false;
    }

    nextButton.scrollIntoView({ block: 'center', behavior: 'auto' });
    nextButton.click();

    nextRetryCount = 0;

    console.log('[Davispeed] Seguinte clicado após escolher o serviço.');

    if (!await waitForChange('serviceType', 10000)) {
      await stop(
        'Selecionei o cartão e cliquei em Seguinte, mas o portal não confirmou o avanço.',
        'warn'
      );
      return false;
    }

    return true;
  }

  async function stop(message, kind = 'warn') {
    const nextUnavailable = /n[aã]o encontrei.*seguinte/i.test(message);

    if (nextUnavailable && !stopRequested) {
      nextRetryCount++;

      if (nextRetryCount <= MAX_NEXT_RETRIES) {
        state.autoContinue = true;
        await saveState();

        status(
          `${message} Vou voltar a clicar em Iniciar / Continuar ` +
          `(tentativa ${nextRetryCount}/${MAX_NEXT_RETRIES})…`,
          'warn'
        );

        scheduleResume(1000);
        return;
      }

      nextRetryCount = 0;
      message += ' Não foi possível encontrar o botão após várias tentativas.';
      kind = 'error';
    }

    state.autoContinue = false;
    resumePending = false;

    await saveState();
    status(message, kind);
  }

  async function waitForAutomaticAdvance(expectedStage, timeout = 12000) {
    const deadline = Date.now() + timeout;

    while (Date.now() < deadline) {
      if (stopRequested) return 'stopped';

      await sleep(250);

      const current = detectStage();

      if (current !== expectedStage && current !== 'unknown') {
        return 'advanced';
      }
    }

    return 'timeout';
  }

  async function waitForChange(oldStage, timeout = 10000) {
    const deadline = Date.now() + timeout;

    while (Date.now() < deadline) {
      if (stopRequested) return false;

      await sleep(250);

      const current = detectStage();

      if (current !== oldStage && current !== 'unknown') return true;
    }

    return false;
  }

  async function advance(oldStage) {
    await savePanel();
    await sleep(200);

    const current = detectStage();

    if (current === oldStage || current === 'unknown') {
      if (!clickNext()) {
        await stop('Não encontrei o botão Seguinte ativo.', 'warn');
        return false;
      }
    }

    if (!await waitForChange(oldStage)) {
      await stop(
        'O portal não confirmou a mudança de etapa. Verifica se existe uma validação.',
        'warn'
      );

      return false;
    }

    return true;
  }

  function scheduleResume(delay = 1000) {
    if (resumePending || stopRequested || !ui) return;

    resumePending = true;

    const attemptClick = () => {
      if (stopRequested || !ui) {
        resumePending = false;
        return;
      }

      if (running) {
        setTimeout(attemptClick, 300);
        return;
      }

      readPanel();

      const missing = missingRequiredFields();

      if (missing.length) {
        resumePending = false;

        status(
          `Retoma cancelada. Preenche os campos: ${missing.join(', ')}.`,
          'warn'
        );

        syncStartButton();
        return;
      }

      syncStartButton();

      if (ui.start.disabled) {
        setTimeout(attemptClick, 300);
        return;
      }

      resumePending = false;

      status('A retomar pelo botão Iniciar / Continuar…', 'success');

      console.log('[Davispeed] A clicar em Iniciar / Continuar.');
      ui.start.click();
    };

    setTimeout(attemptClick, delay);
  }

  async function retryPhysicalStage(reason) {
    if (stopRequested) return false;

    physicalRetryCount++;

    if (physicalRetryCount > MAX_PHYSICAL_RETRIES) {
      physicalRetryCount = 0;

      await stop(
        `Não foi possível concluir o estado físico após ${MAX_PHYSICAL_RETRIES} retomas. ${reason}`,
        'error'
      );

      return false;
    }

    await savePanel();

    status(
      `${reason} Vou voltar a clicar em Iniciar / Continuar ` +
      `(retoma ${physicalRetryCount}/${MAX_PHYSICAL_RETRIES})…`,
      'warn'
    );

    scheduleResume(1000);
    return true;
  }

  async function run() {
    if (running || !ui) return;

    await savePanel();

    const missing = missingRequiredFields();

    if (missing.length) {
      syncStartButton();

      status(
        `Preenche os campos obrigatórios: ${missing.join(', ')}.`,
        'error'
      );

      const focus = {
        'Assinatura': ui.signature,
        'Tipo de Serviço': ui.serviceType,
        'Nº Série / IMEI': ui.serial,
        'Detalhes do estado físico': ui.extraPhysicalDetails,
        'descrição dos acessórios': ui.accessoryDetails,
        'Detalhes da anomalia': ui.otherProblem
      };

      (focus[missing[0]] || ui.condition).focus();
      return;
    }

    running = true;
    stopRequested = false;

    syncStartButton();
    ui.stop.disabled = false;

    state.autoContinue = true;
    await saveState();

    status('A preencher o processo…', 'info');

    try {
      for (let step = 0; step < 40; step++) {
        if (stopRequested) {
          await stop('Automação parada pelo utilizador.', 'warn');
          return;
        }

        await sleep(250);

        const stage = detectStage();

        console.log('[Davispeed] Etapa detetada:', stage);

        if (stage === 'customer') {
          physicalRetryCount = 0;
          nextRetryCount = 0;

          await stop(
            'Cheguei aos dados do cliente/email. Parei para preencheres manualmente.',
            'success'
          );

          return;
        }

        if (stage === 'serviceWarranty') {
          if (!clickChoice('Não')) {
            await stop(
              'Não encontrei a opção Não na pergunta sobre a garantia.',
              'error'
            );
            return;
          }

          await sleep(250);

          if (!await advance('serviceWarranty')) return;
          continue;
        }

        if (stage === 'serviceType') {
          if (!isServiceProcess()) {
            await stop(
              'Foi detetada a etapa Tipo de Serviço, mas o processo selecionado não é Serviços Resolve.',
              'warn'
            );
            return;
          }

          const completed = await fillServiceSKU();

          if (!completed) {
            if (!stopRequested && !resumePending) {
              await stop(
                'Não consegui selecionar o cartão do Tipo de Serviço.',
                'error'
              );
            }
            return;
          }

          continue;
        }

        if (stage === 'purchaseDate') {
          if (!await fillPurchaseDate()) {
            await stop(
              'Não consegui preencher ou confirmar a data 02/02/2022. Verifica os campos de dia, mês e ano.',
              'error'
            );
            return;
          }

          if (!await advance('purchaseDate')) return;
          continue;
        }

        if (stage === 'pvp') {
          const price = await fillNumberField('input[name="7988"]', 200);

          if (!price) {
            await stop('Não consegui preencher o PVP com 200.', 'error');
            return;
          }

          if (!await advance('pvp')) return;
          continue;
        }

        if (stage === 'serial') {
          const field = findSerialInput();

          if (!field) {
            await stop('Não encontrei o campo de série/IMEI.', 'error');
            return;
          }

          setNativeValue(field, state.serial);
          await sleep(300);

          if (String(field.value || '').trim() !== state.serial.trim()) {
            await stop(
              'Não consegui confirmar o número de série/IMEI.',
              'error'
            );
            return;
          }

          if (!await advance('serial')) return;
          continue;
        }

        if (stage === 'condition') {
          if (!clickChoice(state.condition)) {
            await stop(`Não encontrei a opção "${state.condition}".`, 'error');
            return;
          }

          await sleep(250);

          if (!await advance('condition')) return;
          continue;
        }

        // Estado físico: 7982 em Serviços Resolve e 4228 em Garantia/Orçamento.
        if (stage === 'physical') {
          const description = String(ui.extraPhysicalDetails.value || '')
            .trim()
            .slice(0, 300);

          if (!description) {
            await retryPhysicalStage('A descrição do estado físico está vazia.');
            return;
          }

          const selector = isServiceProcess()
            ? 'textarea[name="7982"]'
            : 'textarea[name="4228"]';

          const field = await setPageFieldAndConfirm(selector, description);

          if (!field) {
            await retryPhysicalStage(
              `O estado físico não ficou preenchido ou confirmado no campo ${selector}.`
            );
            return;
          }

          const verify = document.querySelector(selector);

          if (
            !verify ||
            !visible(verify) ||
            String(verify.value || '').trim() !== description
          ) {
            await retryPhysicalStage(
              `A caixa ${selector} não contém a descrição esperada.`
            );
            return;
          }

          console.log(`[Davispeed] Estado físico confirmado em ${selector}.`);

          status('Estado físico preenchido. A aguardar 1 segundo…', 'success');
          await sleep(1000);

          if (stopRequested) {
            await stop('Automação parada pelo utilizador.', 'warn');
            return;
          }

          if (!await advance('physical')) return;

          physicalRetryCount = 0;
          continue;
        }

        if (stage === 'accessories') {
          if (!clickChoice(state.accessories)) {
            await stop(
              `Não encontrei a opção de acessórios "${state.accessories}".`,
              'error'
            );
            return;
          }

          await sleep(250);

          if (!isServiceProcess() && state.accessories === 'Sim') {
            const field = await setPageFieldAndConfirm(
              'textarea[name="4682"]',
              state.accessoryDetails
            );

            if (!field) {
              await stop(
                'Não consegui confirmar a descrição dos acessórios.',
                'error'
              );
              return;
            }
          }

          if (!await advance('accessories')) return;
          continue;
        }

        if (stage === 'damageType') {
          if (!clickChoice('Constante')) {
            await stop(
              'Não encontrei a opção Constante na tipificação da avaria.',
              'error'
            );
            return;
          }

          await sleep(250);

          if (!await advance('damageType')) return;
          continue;
        }

        // Anomalia: 8224 em Serviços Resolve e 4215 em Garantia/Orçamento.
        if (stage === 'anomaly') {
          const description = String(ui.otherProblem.value || '')
            .trim()
            .slice(0, 300);

          if (!description) {
            await stop(
              'Preenche os detalhes da anomalia no painel.',
              'error'
            );
            return;
          }

          const selector = isServiceProcess()
            ? 'textarea[name="8224"]'
            : 'textarea[name="4215"]';

          const field = await setPageFieldAndConfirm(selector, description);

          if (!field) {
            console.error('[Davispeed] Falha ao preencher anomalia.', {
              selector,
              etapa: detectStage(),
              campoEncontrado: Boolean(document.querySelector(selector))
            });

            await stop(
              `Não consegui preencher ou confirmar a descrição da avaria no campo ${selector}.`,
              'error'
            );
            return;
          }

          if (String(field.value || '').trim() !== description) {
            await stop(
              `O texto da avaria não ficou confirmado no campo ${selector}.`,
              'error'
            );
            return;
          }

          console.log(`[Davispeed] Anomalia confirmada em ${selector}.`);

          if (!await advance('anomaly')) return;
          continue;
        }

        if (stage === 'origin') {
          let selected = false;

          for (let attempt = 1; attempt <= 3; attempt++) {
            if (stopRequested) {
              await stop('Automação parada pelo utilizador.', 'warn');
              return;
            }

            status(`A selecionar Loja (tentativa ${attempt}/3)…`, 'info');

            if (clickChoice('Loja')) {
              selected = true;
              break;
            }

            await sleep(500);
          }

          if (!selected) {
            await stop(
              'Não consegui selecionar Loja na localização física do artigo.',
              'error'
            );
            return;
          }

          await sleep(300);

          if (!await advance('origin')) return;
          continue;
        }

        if (stage === 'woc') {
          if (!clickChoice('Não')) {
            await stop('Não consegui selecionar Não na etapa WOC.', 'error');
            return;
          }

          const result = await waitForAutomaticAdvance('woc', 1500);

          if (result === 'stopped') {
            await stop('Automação parada pelo utilizador.', 'warn');
            return;
          }

          if (result === 'advanced') continue;

          if (!await advance('woc')) return;
          continue;
        }

        if (stage === 'attachments') {
          status('Anexos detetados. A avançar sem adicionar imagens…', 'info');

          if (!clickNext()) {
            await stop(
              'Não encontrei o botão Seguinte na etapa Anexos.',
              'warn'
            );
            return;
          }

          await sleep(1200);

          let currentStage = detectStage();

          if (currentStage === 'attachments') {
            await sleep(800);

            if (!clickNext()) {
              await stop(
                'Não encontrei Seguinte na segunda tentativa em Anexos.',
                'warn'
              );
              return;
            }

            await sleep(1200);
            currentStage = detectStage();
          }

          if (currentStage === 'attachments' || currentStage === 'unknown') {
            await stop(
              'Não consegui confirmar o avanço da etapa Anexos.',
              'warn'
            );
            return;
          }

          continue;
        }

        // Assinatura no campo 4265 em ambos os tipos de processo.
        if (stage === 'additional') {
          const signature = String(ui.signature.value || '')
            .trim()
            .slice(0, 300);

          if (!signature) {
            await stop(
              'A assinatura é obrigatória. Preenche a caixa Assinatura no painel.',
              'error'
            );
            return;
          }

          const selector = 'textarea[name="4265"]';
          const field = await setPageFieldAndConfirm(selector, signature);

          if (!field) {
            console.error(
              '[Davispeed] Não foi possível preencher a assinatura.',
              {
                processo: state.processType,
                seletor: selector,
                campoEncontrado: Boolean(document.querySelector(selector)),
                etapa: detectStage()
              }
            );

            await stop(
              `Não consegui preencher ou confirmar a assinatura no campo ${selector}.`,
              'error'
            );
            return;
          }

          if (String(field.value || '').trim() !== signature) {
            await stop(
              'A assinatura não ficou confirmada no campo 4265.',
              'error'
            );
            return;
          }

          console.log(
            `[Davispeed] Assinatura preenchida e confirmada no campo 4265. Processo: ${state.processType}.`
          );

          if (!await advance('additional')) return;
          continue;
        }

        await stop(
          'Não reconheci a etapa atual e parei por segurança. Os dados do painel continuam guardados.',
          'warn'
        );
        return;
      }

      await stop(
        'Atingi o limite de etapas de segurança. Verifica o portal.',
        'warn'
      );
    } catch (error) {
      console.error('[Davispeed]', error);

      await stop(
        `Ocorreu um erro: ${error?.message || error}`,
        'error'
      );
    } finally {
      running = false;

      if (ui) {
        syncStartButton();
        ui.stop.disabled = true;
      }
    }
  }

