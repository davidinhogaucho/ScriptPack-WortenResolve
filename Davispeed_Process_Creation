      close: $('close'),

      processType: $('processType'),
      signature: $('signature'),
      serviceType: $('serviceType'),
      serviceTypeWrap: $('serviceTypeWrap'),

      serial: $('serial'),
      condition: $('condition'),
      extraPhysicalDetails: $('extraPhysicalDetails'),
      accessories: $('accessories'),
      accessoryDetails: $('accessoryDetails'),
      accessoryDetailsWrap: $('accessoryDetailsWrap'),
      problem: $('problem'),
      otherProblem: $('otherProblem'),

      start: $('start'),
      stop: $('stop'),
      status: $('status')
    };

    ui.toggle.addEventListener('click', () => {
      ui.panel.classList.toggle('open');
    });

    ui.close.addEventListener('click', () => {
      ui.panel.classList.remove('open');
    });

    ui.start.addEventListener('click', () => {
      console.log('[Davispeed] Botão Iniciar / Continuar acionado.');
      void run();
    });

    ui.stop.addEventListener('click', async () => {
      stopRequested = true;
      state.autoContinue = false;
      resumePending = false;

      await saveState();

      ui.stop.disabled = true;
      status('Pedido para parar recebido…', 'warn');
    });

    const save = () => {
      readPanel();
      syncProcessUI();
      void saveState();
    };

    [
      ui.processType,
      ui.signature,
      ui.serviceType,
      ui.serial,
      ui.condition,
      ui.extraPhysicalDetails,
      ui.accessoryDetails,
      ui.otherProblem
    ].forEach(element => {
      element.addEventListener('input', save);
      element.addEventListener('change', save);
    });

    ui.processType.addEventListener('change', () => {
      readPanel();
      syncProcessUI();
      void saveState();

      status(
        isServiceProcess()
          ? 'Selecionado: Serviços Resolve.'
          : 'Selecionado: Garantia / Orçamento.',
        'info'
      );
    });

    ui.accessories.addEventListener('change', () => {
      if (ui.accessories.value !== 'Sim') {
        ui.accessoryDetails.value = '';
      }

      readPanel();
      syncProcessUI();
      void saveState();
    });

    ui.problem.addEventListener('change', () => {
      ui.otherProblem.value = problemTemplate(ui.problem.value);

      readPanel();
      syncProcessUI();
      void saveState();
    });

    syncProcessUI();
  }

  async function boot() {
    if (document.getElementById('davispeed-process-creation-host')) return;

    try {
      createUI();
      status('A carregar os dados guardados…', 'info');

      state = await loadState();

      if (!ui) return;

      ui.processType.value =
        Object.values(PROCESS_TYPES).includes(state.processType)
          ? state.processType
          : PROCESS_TYPES.GUARANTEE;

      ui.signature.value = state.signature || '';

      ui.serviceType.value =
        Object.prototype.hasOwnProperty.call(SERVICE_TYPES, state.serviceType)
          ? state.serviceType
          : 'Apple';

      ui.serial.value = state.serial || '';

      ui.condition.value = CONDITIONS.includes(state.condition)
        ? state.condition
        : CONDITIONS[0];

      ui.extraPhysicalDetails.value = state.extraPhysicalDetails || '';
      ui.accessories.value = state.accessories === 'Sim' ? 'Sim' : 'Não';
      ui.accessoryDetails.value = state.accessoryDetails || '';

      ui.problem.value = PROBLEMS.includes(state.problem)
        ? state.problem
        : PROBLEMS[0];

      ui.otherProblem.value =
        state.otherProblem || problemTemplate(ui.problem.value);

      state.otherProblem = ui.otherProblem.value;

      syncProcessUI();
      await saveState();

      if (state.autoContinue) {
        const missing = missingRequiredFields();

        ui.panel.classList.add('open');

        if (missing.length) {
          state.autoContinue = false;
          await saveState();

          status(
            `Continuação pausada. Preenche: ${missing.join(', ')}.`,
            'warn'
          );
        } else {
          status('A retomar o preenchimento…', 'info');

          await sleep(800);

          if (state.autoContinue) void run();
        }
      } else {
        const missing = missingRequiredFields();

        status(
          missing.length
            ? `Preenche os campos obrigatórios: ${missing.join(', ')}.`
            : 'Pronto para iniciar.',
          'info'
        );
      }

      syncProcessUI();
    } catch (error) {
      console.error('[Davispeed] Erro ao iniciar a interface:', error);
    }
  }

  void boot();

  new MutationObserver(() => {
    if (!document.getElementById('davispeed-process-creation-host')) {
      void boot();
    }
  }).observe(document.documentElement, {
    childList: true,
    subtree: true
  });
})();
